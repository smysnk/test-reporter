{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://test-station.smysnk.com/schemas/performance-checkpoint-v1.json",
  "type": "object",
  "required": ["schemaVersion", "phase", "status", "baselineId", "target", "environment", "metrics", "correctnessGates", "deliverables", "waivers"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "phase": { "pattern": "^phase-[0-6]$" },
    "status": { "enum": ["candidate", "accepted", "green", "rejected"] },
    "baselineId": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["commit", "imageDigest", "deployedRevisionVerified"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "deployedRevisionVerified": { "type": "boolean" }
      }
    },
    "metrics": { "type": "array", "minItems": 1 },
    "correctnessGates": { "type": "array" },
    "deliverables": { "type": "array" },
    "waivers": { "type": "array" }
  }
}
