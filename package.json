{
  "name": "test-station",
  "description": "Framework-agnostic test orchestration and reporting toolkit.",
  "type": "module",
  "bin": "./bin/test-station.mjs",
  "exports": {
    "./config": "./config.mjs",
    "./bin": "./bin/test-station.mjs"
  },
  "keywords": [
    "testing",
    "test-reporting",
    "coverage",
    "playwright",
    "vitest",
    "jest",
    "node-test",
    "monorepo"
  ],
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "mono-helper env yarn workspaces foreach -A --include server --include web -pi -j unlimited run dev",
    "build": "yarn workspaces foreach -A run build",
    "lint": "yarn workspaces foreach -A run lint",
    "test:node": "node --test ./tests/*.test.js",
    "test": "node ./bin/test-station.mjs run --config ./test-station.config.mjs",
    "test:coverage": "node ./bin/test-station.mjs run --config ./test-station.config.mjs --coverage",
    "test:e2e:performance": "playwright test -c ./playwright.performance.config.mjs",
    "test:e2e:performance:list": "playwright test -c ./playwright.performance.config.mjs --list",
    "test:performance:report": "node ./bin/test-station.mjs run --config ./test-station.performance.config.mjs",
    "fixture:performance": "node ./scripts/generate-performance-fixture.mjs",
    "fixture:performance:seed": "node ./scripts/seed-performance-fixtures.mjs",
    "benchmark:ingest": "node ./scripts/benchmark-ingest-normalization.mjs",
    "benchmark:ingest:e2e": "node ./scripts/benchmark-end-to-end-ingest.mjs",
    "benchmark:mixed-load": "node ./scripts/mixed-load-benchmark.mjs",
    "benchmark:query-plan": "node ./scripts/capture-postgres-query-plan.mjs",
    "validate:postgres-refactor": "node ./scripts/validate-postgres-refactor.mjs",
    "backfill:report-submissions": "node ./scripts/backfill-report-submissions.mjs",
    "test:e2e:interactions": "playwright test -c ./playwright.interactions.config.mjs",
    "test:e2e:interactions:list": "playwright test -c ./playwright.interactions.config.mjs --list",
    "pages:build": "node ./scripts/pages/build-self-test-site.mjs",
    "benchmark:profile-summary": "node ./scripts/profile-benchmark-summary.mjs",
    "checkpoint:generate": "node ./scripts/generate-phase-checkpoint.mjs",
    "checkpoint:validate": "node ./scripts/validate-phase-checkpoint.mjs",
    "reports:regenerate": "node ./scripts/regenerate-stored-reports.mjs",
    "server:dev": "yarn workspace server dev",
    "server:start": "yarn workspace server start",
    "server:build": "yarn workspace server build",
    "server:lint": "yarn workspace server lint",
    "web:dev": "yarn workspace web dev",
    "web:start": "yarn workspace web start",
    "web:build": "yarn workspace web build",
    "web:lint": "yarn workspace web lint",
    "check": "yarn lint && yarn test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  }
}
